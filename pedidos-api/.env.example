# Local dev uses the pedidos-postgres Docker container on :5433
DATABASE_URL=postgresql://pedidos:pedidos@127.0.0.1:5433/pedidos
JWT_SECRET=replace-with-random-32-byte-hex
JWT_EXPIRES_IN=7d
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@example.com
WEB_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
